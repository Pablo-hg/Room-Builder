{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-terra",
  "commands": {
    "gratis": {
      "description": "Petición o continuación con DeepSeek gratuito (ejecución puntual)",
      "model": "opencode/deepseek-v4.1-flash-free",
      "subagent": false,
      "template": "Petición: $ARGUMENTS. Usa el contexto disponible y resuelve lo pedido con el menor trabajo necesario. Si es una consulta sencilla, responde sin inspeccionar Git, archivos ni documentación. Si implica modificar código o retomar trabajo, comprueba solo la rama, los cambios locales y los archivos relevantes; si esta sesión no conoce la tarea anterior de Codex, consulta .ai/TASK_HANDOFF.md si existe y solicita únicamente el objetivo que falte. Cumple AGENTS.md y lee la documentación pertinente solo si hace falta; evita volver a investigar lo ya verificado. Usa únicamente este modelo gratuito, sin subagentes ni APIs de pago. No hagas commits ni merges sin autorización. Resume brevemente cambios, pruebas y pendientes."
    },
    "gratis-alternativa": {
      "description": "Continuar con MiMo gratuito (una ejecución)",
      "model": "opencode/mimo-v2.6-flash-free",
      "subagent": false,
      "template": "Continúa la tarea actual: $ARGUMENTS. Conserva cambios locales y contexto de la sesión. Usa solo este modelo gratuito; no lances subagentes de pago ni ejecutes commits o merges sin permiso."
    },
    "gratis-rapido": {
      "description": "Tareas ligeras con GLM gratuito (una ejecución)",
      "model": "opencode/glm-5.3-flash-free",
      "subagent": false,
      "template": "Resuelve este ajuste concreto: $ARGUMENTS. Revisa solo el código necesario, haz cambios mínimos y verifica lo relevante. No uses modelos de pago ni hagas commits o merges sin autorización."
    },
    "gratis-profundo": {
      "description": "Problemas complejos con Nemotron Ultra gratuito (una ejecución)",
      "model": "opencode/nemotron-3-ultra-free",
      "subagent": false,
      "template": "Continúa esta tarea compleja: $ARGUMENTS. Revisa las decisiones necesarias y cambios existentes; razona sobre dependencias y valida el resultado. Evita leer todo el repositorio. No uses modelos de pago ni hagas commits o merges sin permiso."
    },
    "gratis-visual": {
      "description": "Análisis visual con Nemotron Super VL gratuito (una ejecución)",
      "model": "opencode/nemotron-3.5-super-vl-free",
      "subagent": false,
      "template": "Analiza la parte visual de esta tarea: $ARGUMENTS. Utiliza capturas disponibles si procede, distingue observación de hipótesis y conserva el contexto. No uses modelos de pago ni hagas commits o merges sin autorización."
    },
    "traspaso-codex": {
      "description": "Guardar estado para retomar y revisar después en Codex (gratis)",
      "model": "opencode/deepseek-v4.1-flash-free",
      "subagent": false,
      "template": "Prepara el traspaso a Codex de la tarea actual. Crea o actualiza .ai/TASK_HANDOFF.md con TAREA (objetivo y aceptación), RAMA y estado Git, BASE anterior al trabajo gratuito si se conoce (no inventarla), HECHO (archivos y decisiones), PRUEBAS realizadas con su resultado, PENDIENTE, RIESGOS y ASPECTOS A REVISAR POR CODEX. Apóyate en el contexto de esta sesión y en git status/diff; no reproduzcas diffs enteros, ni incluyas secretos. No cambies código ni repitas pruebas salvo que una comprobación mínima sea imprescindible para reflejar el estado. No hagas commits ni merges. Responde con la ruta creada y un resumen de 3 líneas."
    }
  }
}
