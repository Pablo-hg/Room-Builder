{
  "name": "room-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-diagnostics-bundle.mjs",
    "preview": "vite preview",
    "test": "tsx --test src/**/*.test.ts",
    "test:watch": "tsx --test --watch src/**/*.test.ts",
    "test:e2e": "playwright test",
    "capture:r0-baseline": "playwright test --config=playwright.baseline.config.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^18.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.1.0"
  }
}
